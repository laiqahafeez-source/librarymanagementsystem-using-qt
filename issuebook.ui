  <property name="styleSheet">
   <string notr="true">QWidget#issuebook { background-color: #f4f6fa; }
QLabel#TITLE { color: #1f3a5f; }
QLabel#lblSubtitle { color: #6b7a90; }
QGroupBox { font-weight: bold; color: #1f3a5f; border: 1px solid #c9d3e0; border-radius: 8px; margin-top: 12px; background: white; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 6px; }
QLineEdit, QComboBox, QDateEdit, QSpinBox, QTextEdit { border: 1px solid #b8c4d4; border-radius: 4px; padding: 5px; background: white; }
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QTextEdit:focus { border: 1px solid #2f6fdb; }
QLineEdit:read-only { background: #eef1f6; }
QPushButton { border: none; border-radius: 5px; padding: 8px 18px; background: #2f6fdb; color: white; font-weight: bold; }
QPushButton:hover { background: #2458b3; }
QPushButton#btnClear { background: #7d8a9c; }
QPushButton#btnClose { background: #d9534f; }
QPushButton#btnReturnSelected { background: #2e9e5b; }
QPushButton#btnDelete { background: #d9534f; }
QTableWidget { background: white; alternate-background-color: #f4f7fb; gridline-color: #dde4ee; }
QHeaderView::section { background: #1f3a5f; color: white; padding: 6px; border: none; font-weight: bold; }</string>
